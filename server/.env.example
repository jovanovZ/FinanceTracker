# --------------------------------------------
# DATABASE
# --------------------------------------------

# OPCIJA A - Lokalni MongoDB (če imaš nameščen MongoDB + Compass)
# Namesti: https://www.mongodb.com/try/download/community
MONGO_URI=mongodb://localhost:27017/financetracker-dev

# OPCIJA B - MongoDB Atlas (če nimaš lokalnega MongoDB)
# Dobi connection string od vodje projekta (Zdravko) prek Discord DM
# OPCIJA B - MongoDB Atlas
#MONGO_URI=mongodb+srv://<username>:<password>@financetracker.bur2wfy.mongodb.net/financetracker-test?appName=FinanceTracker
