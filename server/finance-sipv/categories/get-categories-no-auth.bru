meta {
  name: GET - kategorije bez tokena
  type: http
  seq: 8
}

get {
  url: {{API_URL}}/category
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.body.success: eq false
}

script:post-response {
  test("Error poruka pominje autorizaciju", function() {
    const msg = (res.body.message || "").toLowerCase();
    expect(msg.includes("token") || msg.includes("authorized")).to.be.true;
  });
}
