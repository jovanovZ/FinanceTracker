meta {
  name: login - pogresna lozinka
  type: http
  seq: 3
}

post {
  url: {{API_URL}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "pogresna_lozinka"
  }
}

assert {
  res.status: eq 400
}

script:post-response {
  test("Response ima error poruku", function() {
    expect(res.body).to.have.property("error");
  });
}
