meta {
  name: DELETE - obriši transakciju
  type: http
  seq: 5
}

delete {
  url: {{API_URL}}/transaction/{{transaction_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

assert {
  res.status: eq 200
  res.body.message: isDefined
  res.body.id: isDefined
}

script:post-response {
  test("Confirmation poruka postoji", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });

  test("Vraćen je ID obrisane transakcije", function() {
    expect(res.body.id).to.equal(bru.getVar("transaction_id"));
  });

  bru.setVar("transaction_id", "");
  console.log("Transakcija obrisana");
}
