meta {
  name: POST - import bez fajla
  type: http
  seq: 2
}

post {
  url: {{API_URL}}/import/csv
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:multipart-form {
}

assert {
  res.status: eq 400
  res.body.success: eq false
  res.body.message: isDefined
}

script:post-response {
  test("Error poruka postoji", function() {
    expect(res.body.message).to.be.a("string").and.not.empty;
  });
}
